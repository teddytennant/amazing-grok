MAC = sys.platform == "darwin"

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "amazing-grok"


def load_config():
    """~/.config/amazing-grok/config holds AMAZING_GROK_*=value lines, the
    same names as the environment variables (which win over the file)."""
    try:
        lines = (CONFIG / "config").read_text().splitlines()
    except OSError:
        return
    for line in lines:
        key, sep, value = line.partition("=")
        key = key.strip()
        if sep and key.startswith("AMAZING_GROK_") and not line.lstrip().startswith("#"):
            os.environ.setdefault(key, value.strip().strip('"'))


load_config()

